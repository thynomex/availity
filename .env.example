# Availity Configuration

# Provider: "discord" (default) or "http" (requires authorized endpoint)
PROVIDER=discord

# Discord Provider settings
DISCORD_TOKEN=
DISCORD_TOKENS_FILE=tokens.txt
DISCORD_MULTI_TOKEN=false
DISCORD_WEBHOOK_URL=

# HTTP Provider settings (only needed if PROVIDER=http)
API_ENDPOINT=
API_KEY=

# Rate limiting / concurrency
# CONCURRENCY controls how many usernames are checked simultaneously (max 1000)
CONCURRENCY=50
REQUEST_DELAY=0
MAX_RETRIES=3

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60.0

# Generation limits
MAX_CANDIDATES=1000
MIN_USERNAME_LENGTH=2
MAX_USERNAME_LENGTH=32

# Dictionary word list
WORDLIST_URL=https://raw.githubusercontent.com/dwyl/english-words/master/words_alpha.txt

# Paths
DB_PATH=data/checker.db
LOG_PATH=logs/app.log
OUTPUT_DIR=output
